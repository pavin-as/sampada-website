---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const [posts, mlPosts] = await Promise.all([
    getCollection('blog'),
    getCollection('blog-ml'),
  ]);
  const mlSlugs = new Set(mlPosts.map((post) => post.id));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, hasTranslation: mlSlugs.has(post.id) },
  }));
}

const { post, hasTranslation } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  {...post.data}
  slug={post.id}
  altHref={hasTranslation ? `/ml/blog/${post.id}/` : undefined}
  altLabel={hasTranslation ? 'മലയാളത്തിൽ വായിക്കുക' : undefined}
>
  <Content />
</BlogPost>

