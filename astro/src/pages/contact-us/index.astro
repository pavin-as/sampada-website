<style>
.svr-contact-actions{padding:8px 0 24px;font-family:"Poppins",sans-serif}
.svr-contact-actions h3{font-family:"DM Serif Display",Georgia,serif;font-weight:400;font-size:30px;color:#04092A;margin:0 0 10px}
.svr-contact-actions p{color:#3C4048;line-height:1.7;margin:0 0 18px;max-width:420px}
.svr-cbtn{display:block;max-width:320px;text-align:center;padding:14px 26px;margin:0 0 12px;border-radius:999px;font-weight:600;font-size:15px;text-decoration:none;border:2px solid transparent}
.svr-cbtn--call{background:#F28738;color:#fff}
.svr-cbtn--wa{background:#25d366;color:#fff}
.svr-cbtn--map{border-color:#04092A;color:#04092A}
.svr-cbtn:hover{opacity:.9;color:inherit}
.svr-cbtn--call:hover,.svr-cbtn--wa:hover{color:#fff}
.svr-contact-actions .svr-contact-hours{font-size:14px;color:#6B7080;margin-top:16px}
</style>
