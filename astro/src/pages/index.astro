---
import '../styles/legacy-home.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';
import TreatmentGrid from '../components/TreatmentGrid.astro';
import '../styles/site.css';
import { getCollection } from 'astro:content';
import instagram from '../data/instagram.json';
import { INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../data/site';

// "Latest updates": each slide is a featured article. Titles/excerpts are editorial; hero image,
// category, date and URL come from the blog collection, and the build fails if a post goes missing.
const blogPosts = await getCollection('blog');
const featured = [
  { slug: 'diabetic-retinopathy-retinal-imaging', title: 'Diabetic Retinopathy Screening in Tirur',
    excerpt: 'Diabetic eye damage is often silent. Quick, painless retinal imaging catches it early, before vision is affected.' },
  { slug: 'oct-essential-eye-exam-tool', title: 'OCT: The Essential Eye Exam Tool',
    excerpt: 'A cross-sectional scan of the retina that reveals problems long before symptoms appear.' },
  { slug: 'humphrey-field-analyzer-glaucoma-detection', title: 'Humphrey Field Analyzer for Glaucoma',
    excerpt: 'The gold standard in visual field testing, used to detect glaucoma before vision is lost.' },
].map((f) => {
  const post = blogPosts.find((p) => p.id === f.slug);
  if (!post) throw new Error(`Homepage featured blog post not found: ${f.slug}`);
  const cat = post.data.category ?? 'article';
  return {
    ...f,
    href: `/blog/${post.id}/`,
    image: post.data.heroImage ?? '/wp-content/uploads/2024/02/sampadavrblogoct.webp',
    category: cat.charAt(0).toUpperCase() + cat.slice(1),
    dateLabel: post.data.publishDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
  };
});

// Instagram grid: 6 posts (or 4 if fewer are available) from src/data/instagram.json.
const igAll = instagram.posts ?? [];
const igPosts = igAll.slice(0, igAll.length >= 6 ? 6 : igAll.length >= 4 ? 4 : igAll.length);
import reviewData from '../data/reviews.json';
const reviews = reviewData.reviews ?? [];
const initials = (name) =>
  String(name).split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
