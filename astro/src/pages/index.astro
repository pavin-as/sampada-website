		<div class="svr-page">
		<section class="svr-sec" id="latest-updates" aria-labelledby="home-updates-h">
			<div class="svr-wrap">
				<div class="svr-ig__head">
					<div>
						<span class="svr-eyebrow">From Our Blog</span>
						<h2 class="svr-h2" id="home-updates-h" style="margin:0">Latest updates</h2>
					</div>
					<a class="svr-btn svr-btn--outline" href="/blog/">All articles</a>
				</div>
				<div class="svr-updates" data-svr-updates role="region" aria-roledescription="carousel" aria-label="Latest articles">
					<div class="svr-updates__track" tabindex="0">
						{featured.map((a, i) => (
							<article class="svr-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${featured.length}`}>
								<a class="svr-slide__img" href={a.href} tabindex="-1" aria-hidden="true">
									<img src={a.image} alt="" width="1024" height="576" loading={i === 0 ? 'eager' : 'lazy'}>
								</a>
								<div class="svr-slide__body">
									<p class="svr-slide__meta">{a.category} &middot; {a.dateLabel}</p>
									<h3>{a.title}</h3>
									<p>{a.excerpt}</p>
									<div><a class="svr-btn svr-btn--primary" href={a.href}>Read Article <span aria-hidden="true">&rarr;</span><span class="svr-sr">: {a.title}</span></a></div>
								</div>
							</article>
						))}
					</div>
					<div class="svr-updates__nav">
						<button class="svr-updates__btn" type="button" data-dir="-1" aria-label="Previous article">&larr;</button>
						<div class="svr-updates__dots">
							{featured.map((a, i) => <button class="svr-updates__dot" type="button" data-i={i} aria-label={`Show article ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}
						</div>
						<button class="svr-updates__btn" type="button" data-dir="1" aria-label="Next article">&rarr;</button>
					</div>
				</div>
			</div>
		</section>
		</div>

		<script>
			document.querySelectorAll<HTMLElement>('[data-svr-updates]').forEach((root) => {
				const track = root.querySelector<HTMLElement>('.svr-updates__track')!;
				const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.svr-updates__dot'));
				const slideW = () => track.clientWidth + 24;
				const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(dots.length - 1, i)) * slideW(), behavior: 'smooth' });
				const current = () => Math.round(track.scrollLeft / slideW());
				root.querySelectorAll<HTMLButtonElement>('.svr-updates__btn').forEach((b) =>
					b.addEventListener('click', () => go(current() + Number(b.dataset.dir))));
				dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.i))));
				track.addEventListener('scroll', () => {
					const c = current();
					dots.forEach((d, i) => d.setAttribute('aria-current', String(i === c)));
				}, { passive: true });
				track.addEventListener('keydown', (e) => {
					if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
					if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
				});
			});
		</script>
