---
import '../../../styles/legacy-pages.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiteHead from '../../../components/SiteHead.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-ml');
const sortedPosts = posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Prepare searchable data for client-side filtering
const searchableData = sortedPosts.map(post => ({
	slug: post.id,
	title: post.data.title,
	description: post.data.description,
	category: post.data.category || '',
	publishDate: post.data.publishDate.toISOString(),
	publishDateFormatted: post.data.publishDate.toLocaleDateString('ml-IN', { year: 'numeric', month: 'long', day: 'numeric' }),
	heroImage: post.data.heroImage
}));
---

<!DOCTYPE html>
<html lang="ml">
<head>
	<meta charset="UTF-8">
		<title>കണ്ണ് ആരോഗ്യ ബ്ലോഗ് - സമ്പദ VR സ്പെഷ്യാലിറ്റി ഐ കെയർ | ഏറ്റവും പുതിയ വിവരങ്ങൾ</title>
		<meta name="description" content="സമ്പദ VR സ്പെഷ്യാലിറ്റി ഐ കെയർ LLP-യിൽ നിന്നുള്ള ഏറ്റവും പുതിയ കണ്ണ് ആരോഗ്യ വാർത്തകളും നുറുങ്ങുകളും അറിയുക. തിമിരം, വിട്രിയോറെറ്റിന അസുഖങ്ങൾ, കണ്ണ് ആരോഗ്യം എന്നിവയെക്കുറിച്ചുള്ള വിദഗ്ധ ഉപദേശങ്ങൾ.">
<meta name="robots" content="max-image-preview:large">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700&display=swap" rel="stylesheet">
	<style>:lang(ml) { font-family: 'Noto Sans Malayalam', sans-serif; }</style>
	<link rel="alternate" hreflang="en" href="/blog/">
<link rel="canonical" href="https://sampadavr.com/ml/blog/">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"><SiteHead legacy />
</head>
<body class="elementor-kit-7">
			<Header />
				<div data-elementor-type="wp-page" data-elementor-id="305" class="elementor elementor-305" data-elementor-post-type="page">
						
				<section class="elementor-section elementor-top-section elementor-element elementor-element-b679935 elementor-section-boxed elementor-section-height-default elementor-section-height-default wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no" data-id="b679935" data-element_type="section" data-settings='{"background_background":"classic"}'>
							<div class="elementor-background-overlay"></div>
							<div class="elementor-container elementor-column-gap-default">
				<div class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-2fa5267" data-id="2fa5267" data-element_type="column">
	<div class="elementor-widget-wrap elementor-element-populated">
				<div class="elementor-element elementor-element-f1bf96d elementor-widget elementor-widget-heading" data-id="f1bf96d" data-element_type="widget" data-widget_type="heading.default">
		<div class="elementor-widget-container">
	<h2 class="elementor-heading-title elementor-size-default">ബ്ലോഗ്</h2>		</div>
				</div>
		</div>
			</div>
					</section>
				<section class="elementor-section elementor-top-section elementor-element elementor-element-c738529 elementor-section-boxed elementor-section-height-default elementor-section-height-default wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no" data-id="c738529" data-element_type="section">
						<div class="elementor-container elementor-column-gap-default">
				<div class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6d37d7a" data-id="6d37d7a" data-element_type="column">
	<div class="elementor-widget-wrap elementor-element-populated">
				<div class="elementor-element elementor-element-ece59c7 elementor-widget elementor-widget-text-editor" data-id="ece59c7" data-element_type="widget" data-widget_type="text-editor.default">
		<div class="elementor-widget-container">
			<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
				<!-- Language Toggle -->
				<div style="margin-bottom: 20px;">
					<a href="/blog/" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: 1px solid #667eea; border-radius: 20px; color: #667eea; text-decoration: none; font-weight: 600; font-size: 0.85rem;">
						🌐 Read in English
					</a>
				</div>

				<!-- Search Bar -->
				<div style="margin-bottom: 30px;">
					<input 
						type="search" 
						id="blogSearch" 
						placeholder="തലക്കെട്ട്, വിവരണം അല്ലെങ്കിൽ വിഭാഗം അനുസരിച്ച് ബ്ലോഗ് പോസ്റ്റുകൾ തിരയുക..."
						style="width: 100%; padding: 15px 20px; font-size: 1rem; border: 2px solid #e0e0e0; border-radius: 8px; outline: none; transition: border-color 0.3s ease;"
						onfocus="this.style.borderColor='#667eea'"
						onblur="this.style.borderColor='#e0e0e0'"
					/>
					<div id="searchResults" style="margin-top: 10px; font-size: 0.9rem; color: #666;"></div>
				</div>

				<!-- Blog Grid -->
				<div id="blogGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px;">
					{sortedPosts.map((post) => (
						<a 
							href={`/ml/blog/${post.id}/`}
							class="blog-post-card"
							data-title={post.data.title.toLowerCase()}
							data-description={post.data.description.toLowerCase()}
							data-category={(post.data.category || '').toLowerCase()}
							style="text-decoration: none; color: inherit; display: block; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.3s ease, box-shadow 0.3s ease;"
							onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)'"
							onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.1)'"
						>
							{post.data.heroImage && (
								<img src={post.data.heroImage} alt={post.data.title} style="width: 100%; height: 200px; object-fit: cover;" />
							)}
							<div style="padding: 20px;">
								<h3 style="font-size: 1.25rem; margin: 0 0 10px 0; color: #333; font-weight: 600;">{post.data.title}</h3>
								<p style="color: #666; font-size: 0.9rem; margin-bottom: 15px; line-height: 1.5;">{post.data.description}</p>
								<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: #999;">
									<span>
										{post.data.author && <>{post.data.author} · </>}
										<time datetime={post.data.publishDate.toISOString()}>
											{post.data.publishDate.toLocaleDateString('ml-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
										</time>
									</span>
									{post.data.category && (
										<span style="background: #667eea; color: white; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; text-transform: capitalize;">{post.data.category}</span>
									)}
								</div>
							</div>
						</a>
					))}
				</div>

				<!-- No Results Message -->
				<div id="noResults" style="display: none; text-align: center; padding: 60px 20px; color: #999;">
					<svg style="width: 80px; height: 80px; margin: 0 auto 20px; opacity: 0.3;" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
					</svg>
					<h3 style="font-size: 1.5rem; margin: 0 0 10px 0; color: #666;">ബ്ലോഗ് പോസ്റ്റുകൾ ഒന്നും കണ്ടെത്തിയില്ല</h3>
					<p style="font-size: 1rem; color: #999;">തിരയൽ വാക്കുകൾ മാറ്റി വീണ്ടും ശ്രമിക്കുക</p>
				</div>
			</div>

			<!-- Search Script -->
			<script is:inline>
				(function() {
					const searchInput = document.getElementById('blogSearch');
					const blogGrid = document.getElementById('blogGrid');
					const noResults = document.getElementById('noResults');
					const searchResults = document.getElementById('searchResults');
					const allCards = document.querySelectorAll('.blog-post-card');
					const totalPosts = allCards.length;

					function performSearch() {
						const searchTerm = searchInput.value.toLowerCase().trim();
						let visibleCount = 0;

						allCards.forEach(card => {
							const title = card.getAttribute('data-title') || '';
							const description = card.getAttribute('data-description') || '';
							const category = card.getAttribute('data-category') || '';

							const matches = title.includes(searchTerm) || 
											description.includes(searchTerm) || 
											category.includes(searchTerm);

							if (matches) {
								card.style.display = 'block';
								visibleCount++;
							} else {
								card.style.display = 'none';
							}
						});

						// Update results message
						if (searchTerm) {
							if (visibleCount === 0) {
								blogGrid.style.display = 'none';
								noResults.style.display = 'block';
								searchResults.textContent = `"${searchInput.value}" എന്നതിന് ഫലങ്ങളൊന്നും കണ്ടെത്തിയില്ല`;
							} else {
								blogGrid.style.display = 'grid';
								noResults.style.display = 'none';
								searchResults.textContent = `${totalPosts} ൽ ${visibleCount} പോസ്റ്റുകൾ കാണിക്കുന്നു`;
							}
						} else {
							blogGrid.style.display = 'grid';
							noResults.style.display = 'none';
							searchResults.textContent = `എല്ലാ ${totalPosts} പോസ്റ്റുകളും കാണിക്കുന്നു`;
						}
					}

					// Add event listener for search input
					searchInput.addEventListener('input', performSearch);

					// Initialize with all posts visible
					searchResults.textContent = `എല്ലാ ${totalPosts} പോസ്റ്റുകളും കാണിക്കുന്നു`;
				})();
			</script>
		</div>
				</div>
		</div>
			</div>
					</section>
				</div>
<Footer />
</body>
</html>