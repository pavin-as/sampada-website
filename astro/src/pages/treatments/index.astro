---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteHead from '../../components/SiteHead.astro';
import TreatmentGrid from '../../components/TreatmentGrid.astro';
import '../../styles/site.css';
import { getCollection } from 'astro:content';
import { TREATMENT_ORDER, SITE, PHONE_DISPLAY } from '../../data/site';

// Patient FAQs. Answers are HTML strings. Kept in sync with the FAQPage JSON-LD below.
const faqs = [
  {
    q: 'How do I book an appointment?',
    a: `<p>Call <a href="tel:+919188572412">${PHONE_DISPLAY}</a> (or +91 62380 85482), or walk in at the clinic on Railway Station Bypass Road, Thazhepalam, Tirur. We are open Monday 9 AM to 5 PM, Tuesday 3 PM to 5 PM, and Wednesday to Saturday 9 AM to 5 PM. Details and directions are on the <a href="/contact-us/">Contact Us</a> page.</p>`,
  },
  {
    q: 'What should I bring to my first visit?',
    a: `<p>Bring any earlier eye records, scans and prescriptions, and a list of your current medicines, including diabetes and blood pressure medication. Please arrive about 15 minutes early for registration.</p><p>Most first visits include dilating drops, which take 20 to 30 minutes to work and blur near vision for a while afterwards, so it helps to come with someone. See <a href="/treatments/eye-check-up/">what a complete eye check-up includes</a>.</p>`,
  },
  {
    q: 'Will I need to stay in hospital? How long is recovery?',
    a: `<p>Most procedures here are day care, so you go home the same day with a follow-up scheduled and a number to call if anything changes. Cataract surgery, for example, is a day-care procedure and you go home the same day, accompanied by someone.</p><p>Recovery time depends on the procedure. Retinal surgery such as <a href="/treatments/vitrectomy/">vitrectomy</a> needs more careful aftercare than a scan or an injection, and your surgeon will explain the specifics of your plan, including any positioning or activity limits, before the day of surgery.</p>`,
  },
  {
    q: 'What should I do in an eye emergency, such as a sudden shadow or flashes?',
    a: `<p>A sudden curtain or shadow across your vision, a sudden shower of floaters, flashes of light or a sudden drop in vision can mean a <a href="/treatments/retinal-detachment-surgery/">retinal detachment</a>, which is a true emergency. Do not wait to see if it settles. Call us on <a href="tel:+919188572412">${PHONE_DISPLAY}</a> as soon as it starts and ask for a same-day retina assessment.</p><p>Retinal detachment should be assessed the same day. Surgery is usually arranged within days, and sooner if your central vision is still intact. If the clinic is closed when symptoms start, go to the nearest hospital eye emergency service rather than waiting for the next day.</p>`,
  },
  {
    q: 'Do you treat children and premature babies?',
    a: `<p>Yes. Our centre is designed for patients of all ages, including elderly patients and premature babies. We run screening for retinopathy of prematurity (ROP), a condition that can cause blindness in premature infants if it is not caught early.</p>`,
  },
  {
    q: 'I have diabetes but my vision is fine. Do I still need an eye check?',
    a: `<p>Yes. Diabetic eye damage develops without symptoms, and by the time vision blurs the disease is usually advanced. An annual dilated retinal examination is recommended even when your sight seems normal. Read more on <a href="/treatments/diabetic-retinopathy-treatment/">diabetic retinopathy screening and treatment</a>.</p>`,
  },
];
const stripTags = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const entries = await getCollection('treatments');
const ordered = TREATMENT_ORDER.map((s) => entries.find((e) => e.id === s)).filter(Boolean) as typeof entries;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })),
};
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Eye treatments and diagnostics at Sampada VR, Tirur',
  itemListElement: ordered.map((e, i) => ({
    '@type': 'ListItem', position: i + 1, name: e.data.navLabel ?? e.data.procedureName, url: `${SITE}/treatments/${e.id}/`,
  })),
};
---
<!DOCTYPE html>
<html lang="en-US">
<head>
	<meta charset="UTF-8">
		<title>Eye Treatments in Tirur | Retina, Cataract &amp; Glaucoma | Sampada VR</title>
		<meta name="description" content="Eye treatments and tests at Sampada VR, Tirur: cataract surgery, retinal detachment, diabetic retinopathy, glaucoma, intravitreal injections, vitrectomy, OCT and eye check-ups.">
<meta name="robots" content="max-image-preview:large">
	<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sampadavr.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Treatments",
      "item": "https://sampadavr.com/treatments/"
    }
  ]
}
</script>
<link rel="canonical" href="https://sampadavr.com/treatments/">
<script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"><SiteHead />
</head>
<body>
			<Header />
			<main class="svr-page" id="main">

				<section class="svr-hero">
					<div class="svr-wrap">
						<p class="svr-crumb"><a href="/">Home</a> &rsaquo; Treatments</p>
						<h1>Eye treatments and diagnostics in Tirur</h1>
						<p class="svr-lead">Detailed information on each treatment and test we provide, medically reviewed by Dr Sameera V V, vitreoretinal surgeon.</p>
						<div class="svr-hero__actions">
							<a class="svr-btn svr-btn--primary" href="tel:+919188572412">Book Appointment</a>
							<a class="svr-btn svr-btn--ghost" href="#treatment-faq">Common questions</a>
						</div>
					</div>
				</section>

				<section class="svr-sec" aria-labelledby="treatments-h">
					<div class="svr-wrap">
						<div class="svr-sechead">
							<span class="svr-eyebrow">What We Treat</span>
							<h2 class="svr-h2" id="treatments-h">Procedures and tests at Sampada VR</h2>
							<p class="svr-lead">Choose a treatment to see the symptoms, how it is done, recovery and the questions patients ask most.</p>
						</div>
						<TreatmentGrid />
					</div>
				</section>

				<section class="svr-sec svr-sec--mist" id="treatment-faq" aria-labelledby="treatment-faq-h">
					<div class="svr-wrap">
						<div class="svr-sechead svr-sechead--center">
							<span class="svr-eyebrow">Common Questions</span>
							<h2 class="svr-h2" id="treatment-faq-h">Before you visit</h2>
							<p class="svr-lead">Straight answers on booking, recovery and eye emergencies.</p>
						</div>
						<div class="svr-faq">
							{faqs.map((f, i) => (
								<details open={i === 0}>
									<summary>{f.q}</summary>
									<div class="svr-faq__a" set:html={f.a} />
								</details>
							))}
						</div>
					</div>
				</section>

				<section class="svr-sec" aria-labelledby="treatments-cta">
					<div class="svr-wrap">
						<div class="svr-ctaband">
							<div>
								<h2 id="treatments-cta">Not sure which treatment you need?</h2>
								<p>You do not need to decide. A complete eye examination shows what is going on, and Dr Sameera will explain your options plainly before anything is planned.</p>
								<a class="svr-btn svr-btn--primary" href="tel:+919188572412">Call +91 91885 72412</a>
							</div>
							<div class="svr-ctaband__meta">
								<strong>Sampada VR Speciality Eye Care LLP</strong><br>
								Railway Station Bypass Road, Thazhepalam,<br>Tirur, Kerala 676101<br>
								Mon 9 AM&ndash;5 PM &middot; Tue 3 PM&ndash;5 PM &middot; Wed&ndash;Sat 9 AM&ndash;5 PM<br>
								<a href="/contact-us/">Directions and contact details &rarr;</a>
							</div>
						</div>
					</div>
				</section>

			</main>
				<Footer />
</body>
</html>