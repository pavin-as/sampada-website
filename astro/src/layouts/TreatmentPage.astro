---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

export type Faq = { q: string; a: string };
export type Props = {
  title: string;
  h1: string;
  description: string;
  procedureName: string;
  procedureType: 'MedicalProcedure' | 'MedicalTest';
  summary: string;
  slug: string;
  heroImage?: string;
  reviewedBy: string;
  reviewedOn: string;
  faqs: Faq[];
};

const { title, h1, description, procedureName, procedureType, summary, slug,
        heroImage, reviewedBy, reviewedOn, faqs } = Astro.props;

const SITE = 'https://sampadavr.com';
const canonical = `${SITE}/treatments/${slug}/`;

const procedureSchema = {
  '@context': 'https://schema.org',
  '@type': procedureType,
  name: procedureName,
  description,
  url: canonical,
  ...(heroImage ? { image: new URL(heroImage, SITE).href } : {}),
  performedBy: { '@id': `${SITE}/#clinic` },
  availableService: { '@id': `${SITE}/#clinic` },
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: h1,
  description,
  url: canonical,
  inLanguage: 'en-IN',
  lastReviewed: reviewedOn,
  reviewedBy: { '@type': 'Physician', '@id': `${SITE}/about-dr-sameera-v-v/#physician`, name: reviewedBy },
  about: { '@type': procedureType, name: procedureName },
  isPartOf: { '@id': `${SITE}/#clinic` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Treatments', item: `${SITE}/treatments/` },
    { '@type': 'ListItem', position: 3, name: procedureName, item: canonical },
  ],
};

const faqSchema = faqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<!DOCTYPE html>
<html lang="en-IN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="max-image-preview:large">

<meta property="og:type" content="article">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Sampada VR Speciality Eye Care">
{heroImage && <meta property="og:image" content={new URL(heroImage, SITE).href} />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>

<!-- Site stylesheets, same set the rest of sampadavr.com loads, so the shared header renders identically -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<style is:global>
:root{--svr-navy:#04092A;--svr-ink:#3C4048;--svr-muted:#7A7E8C;--svr-line:#E9EBEF;--svr-accent:#F28738;--svr-accent-dk:#D9701F;
--svr-serif:"DM Serif Display",Georgia,"Times New Roman",serif;
--svr-sans:"Poppins","Roboto",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;}
.tx-page{font-family:var(--svr-sans);color:var(--svr-ink);background:#fff;-webkit-font-smoothing:antialiased}
.tx-page main img{max-width:100%;height:auto}
.tx-wrap{max-width:1140px;margin:0 auto;padding:0 20px}
.tx-col{max-width:820px}
.tx-crumb{font-size:14px;color:var(--svr-muted);padding:30px 0 0}
.tx-crumb a{color:var(--svr-muted);text-decoration:none}
.tx-crumb a:hover{color:var(--svr-accent)}
.tx-hero{padding:22px 0 8px}
.tx-hero h1{font-family:var(--svr-serif);font-weight:400;font-size:48px;line-height:1.14;letter-spacing:-.01em;margin:0 0 18px;color:var(--svr-navy)}
.tx-lead{font-size:19px;line-height:1.68;color:var(--svr-muted);margin:0 0 22px}
.tx-byline{font-size:14px;color:var(--svr-muted);border-top:1px solid var(--svr-line);border-bottom:1px solid var(--svr-line);padding:14px 0;margin:0 0 36px}
.tx-byline a{color:var(--svr-accent)}
.tx-body{font-size:17px;line-height:1.8;color:var(--svr-ink)}
.tx-body h2{font-family:var(--svr-serif);font-weight:400;font-size:33px;line-height:1.25;margin:46px 0 16px;color:var(--svr-navy)}
.tx-body h3{font-family:var(--svr-serif);font-weight:400;font-size:23px;margin:32px 0 10px;color:var(--svr-navy)}
.tx-body p{margin:0 0 17px}
.tx-body ul,.tx-body ol{margin:0 0 20px;padding-left:22px}
.tx-body li{margin:0 0 9px}
.tx-body a{color:var(--svr-accent)}
.tx-body strong{color:var(--svr-navy);font-weight:600}
.tx-faq{background:#FAF8F5;border:1px solid var(--svr-line);border-radius:14px;padding:32px;margin:48px 0}
.tx-faq h2{font-family:var(--svr-serif);font-weight:400;font-size:29px;margin:0 0 6px;color:var(--svr-navy)}
.tx-faq details{border-bottom:1px solid #EDE7DF;padding:14px 0}
.tx-faq details:last-child{border-bottom:0}
.tx-faq summary{cursor:pointer;font-weight:600;color:var(--svr-navy);font-size:16px;list-style:none}
.tx-faq summary::-webkit-details-marker{display:none}
.tx-faq summary::before{content:"+";display:inline-block;width:18px;color:var(--svr-accent);font-weight:700}
.tx-faq details[open] summary::before{content:"\2013"}
.tx-faq p{margin:10px 0 0 18px;color:var(--svr-muted);font-size:15.5px;line-height:1.7}
.tx-cta{background:var(--svr-navy);color:#fff;border-radius:14px;padding:38px;margin:48px 0}
.tx-cta h2{font-family:var(--svr-serif);font-weight:400;margin:0 0 10px;color:#fff;font-size:29px}
.tx-cta p{margin:0 0 22px;color:#C2C6D4;line-height:1.65}
.tx-cta a.btn{display:inline-block;background:var(--svr-accent);color:#fff;padding:14px 30px;border-radius:8px;text-decoration:none;font-weight:600;transition:transform .2s ease,box-shadow .2s ease}
.tx-cta a.btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.25)}
.tx-cta .addr{font-size:14px;color:#989DAD;margin-top:22px;line-height:1.7}
.tx-cta .addr a{color:#fff}
.tx-disclaimer{font-size:13px;color:#8F94A1;line-height:1.65;border-top:1px solid var(--svr-line);padding:22px 0 48px;margin-top:10px}
@media(max-width:900px){.tx-hero h1{font-size:33px}.tx-lead{font-size:17px}.tx-body{font-size:16px}
.tx-body h2{font-size:26px;margin-top:36px}.tx-faq,.tx-cta{padding:24px}.tx-cta h2,.tx-faq h2{font-size:24px}}
@media(prefers-reduced-motion:reduce){.tx-cta a.btn{transition:none}.tx-cta a.btn:hover{transform:none}}
</style>
<SiteHead />
</head>
<body class="tx-page">
<Header />

<main class="tx-wrap"><div class="tx-col">
  <nav class="tx-crumb" aria-label="Breadcrumb">
    <a href="/">Home</a> &rsaquo; <a href="/treatments/">Treatments</a> &rsaquo; <span>{procedureName}</span>
  </nav>

  <div class="tx-hero">
    <h1>{h1}</h1>
    <p class="tx-lead">{summary}</p>
    <p class="tx-byline">
      Medically reviewed by <a href="/about-dr-sameera-v-v/">{reviewedBy}</a>, Vitreoretinal Surgeon &middot; Last reviewed {reviewedOn}
    </p>
  </div>

  <article class="tx-body">
    <slot />
  </article>

  {faqs.length > 0 && (
    <section class="tx-faq" aria-labelledby="tx-faq-h">
      <h2 id="tx-faq-h">Common questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  )}

  <section class="tx-cta">
    <h2>Book an appointment in Tirur</h2>
    <p>Speak to our team about {procedureName.toLowerCase()} at Sampada VR Speciality Eye Care.</p>
    <a class="btn" href="tel:+919188572412">Call +91 91885 72412</a>
    <div class="addr">
      Sampada VR Speciality Eye Care LLP<br>
      Railway Station Bypass Road, Thazhepalam, Tirur, Kerala 676101<br>
      Monday to Saturday &middot; <a href="/contact-us/" style="color:#fff">Directions and timings</a>
    </div>
  </section>

  <p class="tx-disclaimer">
    This page is general information about eye care, not medical advice for any individual.
    Treatment depends on your own examination findings. Please consult an ophthalmologist
    before making decisions about your eyes.
  </p>
</div></main>

<Footer />
</body>
</html>
