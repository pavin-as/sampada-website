---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';
import { SITE, PHONE_DISPLAY, PHONE_TEL } from '../data/site';
import { sources, urgentText } from '../data/vision-checks.mjs';
import '../styles/vision-checks.css';
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Sampada VR</title><meta name="description" content={description}/><meta name="robots" content="max-image-preview:large"/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} | Sampada VR`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><SiteHead/></head>
<body class="vision-body"><a class="skip" href="#main">Skip to content</a><Header/>
<main id="main" class="vision-page">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/vision-checks/">Vision checks</a></nav>
<aside class="urgent"><strong>Sudden change in vision?</strong><p>{urgentText}</p><a href={`tel:${PHONE_TEL}`}>Call clinic: {PHONE_DISPLAY}</a><span> · Calling does not guarantee emergency availability.</span></aside>
<slot/>
<section class="privacy"><h2>Your privacy</h2><p>These tools do not ask for your name or phone number. Answers stay in this page’s memory and are not sent to the clinic or saved by the tools. Refreshing clears them. Nothing is monitored by the clinic. A printed or saved summary remains your responsibility to keep private.</p><p>These self-checks cannot diagnose disease or replace an eye examination.</p></section>
<details class="sources"><summary>Sources and review status</summary><p>Content version 1 · Clinical review confirmed 24 October 2026. Currently available in English.</p><ul>{sources.map(([label, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>)}</ul></details>
</main><Footer/></body></html>
