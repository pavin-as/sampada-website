---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'] & {
  slug: string;
  lang?: 'en' | 'ml';
  /** URL of the translated/original counterpart post, if one exists. */
  altHref?: string;
  /** Label for the link to that counterpart, e.g. "മലയാളത്തിൽ വായിക്കുക". */
  altLabel?: string;
};

const { title, description, publishDate, heroImage, slug, lang = 'en', altHref, altLabel, author } = Astro.props;
const htmlLang = lang === 'ml' ? 'ml' : 'en-US';
const canonicalPath = lang === 'ml' ? `/ml/blog/${slug}/` : `/blog/${slug}/`;
const canonicalURL = new URL(canonicalPath, 'https://sampadavr.com').href;
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
	<meta charset="UTF-8">
		<title>{title} &ndash; sampadavr</title>
<meta name="description" content={description}>
<meta name="robots" content="max-image-preview:large">
{lang === 'ml' && (
	<>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700&display=swap" rel="stylesheet">
	<style>:lang(ml) { font-family: 'Noto Sans Malayalam', sans-serif; }</style>
	</>
)}
<meta property="og:type" content="article">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:site_name" content="Sampada VR Speciality Eye Care">
{heroImage && <meta property="og:image" content={new URL(heroImage, 'https://sampadavr.com').href} />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{heroImage && <meta name="twitter:image" content={new URL(heroImage, 'https://sampadavr.com').href} />}
{altHref && (
	<link rel="alternate" hreflang={lang === 'ml' ? 'en' : 'ml'} href={altHref} />
)}
	<link rel="canonical" href={canonicalPath}>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"><SiteHead />
</head>

<body>
			<Header />
				
				<div class="blog-post-content-wrapper" style="max-width: 1200px; margin: 40px auto; padding: 40px 20px; background: white;">
					<article style="line-height: 1.8; font-size: 1.1rem; color: #333;">
						<h1 style="font-size: 2.5rem; margin-bottom: 20px; color: #222;">{title}</h1>
						<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; color: #666; font-size: 0.9rem; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid #eee;">
							<span>
								{author && (
									<>{lang === 'ml' ? 'എഴുതിയത്: ' : 'By '}{author} · </>
								)}
								<time datetime={publishDate.toISOString()}>
									{publishDate.toLocaleDateString(lang === 'ml' ? 'ml-IN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
								</time>
							</span>
							{altHref && (
								<a href={altHref} style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: 1px solid #667eea; border-radius: 20px; color: #667eea; text-decoration: none; font-weight: 600; font-size: 0.85rem;">
									🌐 {altLabel}
								</a>
							)}
						</div>
						{heroImage && (
							<img src={heroImage} alt={title} style="width: 100%; max-height: 500px; object-fit: cover; margin-bottom: 30px; border-radius: 8px;" />
						)}
						<div class="blog-content">
							<slot />
						</div>
					</article>
				</div>
<Footer />
</body>
</html>