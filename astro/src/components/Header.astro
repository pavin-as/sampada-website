---
/**
 * Sitewide header. One component, used by every page and layout.
 * Five primary items + a Treatments dropdown fed by the treatments collection
 * + a prominent Book Appointment / Call button.
 * (Replaces the old Elementor/WordPress header markup, kept in archive/ locally.)
 */
import { getCollection } from 'astro:content';
import { TREATMENT_ORDER, PHONE_DISPLAY, PHONE_TEL } from '../data/site';

const path = Astro.url.pathname;
const is = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));

const entries = await getCollection('treatments');
const treatments = TREATMENT_ORDER
  .map((slug) => entries.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .map((e) => ({ href: `/treatments/${e.id}/`, label: e.data.navLabel ?? e.data.procedureName }));

const nav = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/treatments/', label: 'Treatments', active: is('/treatments/'), menu: true },
  { href: '/about/', label: 'About Us', active: is('/about/') || is('/about-dr-sameera-v-v/') },
  { href: '/blog/', label: 'Blog', active: is('/blog/') || is('/ml/blog/') },
  { href: '/contact-us/', label: 'Contact Us', active: is('/contact-us/') },
];
---
<header class="svr-header" data-svr-header>
  <div class="svr-header__bar">
    <a class="svr-logo" href="/" aria-label="Sampada VR Speciality Eye Care, home">
      <img src="/wp-content/uploads/2021/12/logo-new-sampadavr.png" alt="Sampada VR Speciality Eye Care, eye hospital in Tirur" width="229" height="76">
    </a>

    <nav class="svr-nav" id="svr-nav" aria-label="Primary">
      <ul class="svr-nav__list">
        {nav.map((item) => (
          <li class:list={['svr-nav__item', { 'has-menu': item.menu }]}>
            <a class:list={['svr-nav__link', { 'is-active': item.active }]} href={item.href} aria-current={item.active && !item.menu ? 'page' : undefined}>{item.label}</a>
            {item.menu && (
              <>
                <button class="svr-nav__caret" type="button" aria-expanded="false" aria-controls="svr-mega" aria-label="Show treatments menu">
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="svr-mega" id="svr-mega">
                  <p class="svr-mega__title">Retina &amp; eye care procedures</p>
                  <ul class="svr-mega__grid">
                    {treatments.map((t) => (
                      <li><a href={t.href}>{t.label}</a></li>
                    ))}
                  </ul>
                  <a class="svr-mega__all" href="/treatments/">View all treatments <span aria-hidden="true">&rarr;</span></a>
                </div>
              </>
            )}
          </li>
        ))}
        <li class="svr-nav__item svr-nav__item--cta-mobile">
          <a class="svr-cta" href={`tel:${PHONE_TEL}`}>
            <span class="svr-cta__label">Book Appointment</span>
            <span class="svr-cta__num">Call: {PHONE_DISPLAY}</span>
          </a>
        </li>
      </ul>
    </nav>

    <a class="svr-cta svr-cta--desktop" href={`tel:${PHONE_TEL}`}>
      <svg class="svr-cta__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.25c1.1.37 2.3.57 3.6.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1z"/></svg>
      <span class="svr-cta__text">
        <span class="svr-cta__label">Book Appointment</span>
        <span class="svr-cta__num">Call: {PHONE_DISPLAY}</span>
      </span>
    </a>

    <a class="svr-callchip" href={`tel:${PHONE_TEL}`} aria-label={`Call ${PHONE_DISPLAY}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.25c1.1.37 2.3.57 3.6.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1z"/></svg>
      <span>Call</span>
    </a>

    <button class="svr-burger" type="button" aria-expanded="false" aria-controls="svr-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style is:global>
:root{--svr-navy:#04092A;--svr-accent:#F28738;--svr-accent-dk:#D9701F;--svr-line:#E9EBEF;
--svr-serif:"DM Serif Display",Georgia,"Times New Roman",serif;
--svr-sans:"Poppins","Roboto",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;}

/* page reset: the WordPress theme used to zero the body margin */
body{margin:0}

/* ---------- header shell ---------- */
.svr-header{position:sticky;top:0;z-index:2000;background:#fff;border-bottom:1px solid var(--svr-line);box-shadow:0 2px 14px rgba(4,9,42,.06);font-family:var(--svr-sans)}
.svr-header *,.svr-header *::before,.svr-header *::after{box-sizing:border-box}
.svr-header ul{list-style:none;margin:0;padding:0}
.svr-header a{text-decoration:none}
.svr-header__bar{max-width:1240px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;gap:24px;min-height:76px}
.svr-logo{flex:0 0 auto;display:block;line-height:0}
.svr-logo img{display:block;width:auto;height:76px;max-width:none;margin:-11px 0}

/* ---------- desktop nav ---------- */
.svr-nav{flex:1 1 auto;display:flex;justify-content:center}
.svr-nav__list{display:flex;align-items:center;gap:4px}
.svr-nav__item{position:relative;display:flex;align-items:center}
.svr-nav__item--cta-mobile{display:none}
.svr-header .svr-nav__link{display:block;padding:12px 14px;font-size:15px;font-weight:500;color:var(--svr-navy);letter-spacing:.01em;border-radius:8px;position:relative;transition:color .18s ease}
.svr-header .svr-nav__link::after{content:"";position:absolute;left:14px;right:14px;bottom:6px;height:2px;background:var(--svr-accent);transform:scaleX(0);transform-origin:left;transition:transform .2s ease}
.svr-header .svr-nav__link:hover,.svr-header .svr-nav__link.is-active{color:var(--svr-accent-dk)}
.svr-header .svr-nav__link:hover::after,.svr-header .svr-nav__link.is-active::after{transform:scaleX(1)}
.svr-header button{font-family:inherit;box-shadow:none;text-transform:none;letter-spacing:normal}
.svr-header .svr-nav__caret,.svr-header .svr-nav__caret:hover,.svr-header .svr-nav__caret:focus,.svr-header .svr-nav__caret:active{background:none;color:var(--svr-navy)}
.svr-header .svr-burger,.svr-header .svr-burger:hover,.svr-header .svr-burger:focus{background:none;color:var(--svr-navy)}
.svr-nav__caret{border:0;padding:8px 6px 8px 0;margin-left:-8px;cursor:pointer;color:var(--svr-navy);display:flex;align-items:center;border-radius:6px}
.svr-nav__caret svg{transition:transform .2s ease}
.svr-nav__caret[aria-expanded="true"] svg,.svr-nav__item.has-menu:hover .svr-nav__caret svg{transform:rotate(180deg)}

/* dropdown / mega panel */
.svr-mega{position:absolute;top:100%;left:50%;transform:translate(-50%,8px);width:520px;background:#fff;border:1px solid var(--svr-line);border-radius:14px;box-shadow:0 22px 50px rgba(4,9,42,.16);padding:22px 24px 18px;opacity:0;visibility:hidden;transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:5}
.svr-nav__item.has-menu:hover .svr-mega,.svr-nav__item.has-menu:focus-within .svr-mega,.svr-nav__item.has-menu.is-open .svr-mega{opacity:1;visibility:visible;transform:translate(-50%,0)}
/* hover bridge so the pointer can travel from link to panel */
.svr-nav__item.has-menu::before{content:"";position:absolute;left:0;right:0;top:100%;height:14px}
.svr-mega__title{margin:0 0 10px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#7A7E8C;font-weight:600}
.svr-mega__grid{display:grid;grid-template-columns:1fr 1fr;gap:2px 18px}
.svr-header .svr-mega__grid a{display:block;padding:9px 10px;border-radius:8px;font-size:14.5px;font-weight:500;color:var(--svr-navy);transition:background .15s ease,color .15s ease}
.svr-header .svr-mega__grid a:hover,.svr-header .svr-mega__grid a:focus-visible{background:#FFF3E8;color:var(--svr-accent-dk)}
.svr-header .svr-mega__all{display:block;margin-top:12px;padding-top:14px;border-top:1px solid var(--svr-line);font-size:14px;font-weight:600;color:var(--svr-accent-dk)}
.svr-header .svr-mega__all:hover{color:var(--svr-navy)}

/* ---------- CTA button ---------- */
.svr-header .svr-cta{display:inline-flex;align-items:center;gap:10px;background:var(--svr-accent);color:#fff;border-radius:999px;padding:9px 20px 9px 16px;line-height:1.15;box-shadow:0 6px 16px rgba(242,135,56,.35);transition:background .2s ease,transform .2s ease,box-shadow .2s ease;white-space:nowrap}
.svr-header .svr-cta:hover,.svr-header .svr-cta:focus-visible{background:var(--svr-accent-dk);color:#fff;transform:translateY(-1px);box-shadow:0 10px 22px rgba(242,135,56,.45)}
.svr-cta__text{display:flex;flex-direction:column}
.svr-cta__label{font-size:13px;font-weight:600;letter-spacing:.01em}
.svr-cta__num{font-size:12px;font-weight:500;opacity:.95}
.svr-cta__icon{flex:0 0 auto}
.svr-callchip,.svr-burger{display:none}

/* ---------- tablet / mobile ---------- */
@media (max-width:1100px){
  .svr-header__bar{gap:14px}
  .svr-header .svr-nav__link{padding:12px 10px;font-size:14.5px}
  .svr-header .svr-cta{padding:8px 16px 8px 13px}
}
@media (max-width:980px){
  .svr-header__bar{min-height:64px;padding:8px 16px;justify-content:space-between}
  .svr-logo img{height:62px;margin:-9px 0}
  .svr-cta--desktop{display:none!important}
  .svr-header .svr-callchip{display:inline-flex;align-items:center;gap:7px;margin-left:auto;background:var(--svr-accent);color:#fff;border-radius:999px;padding:9px 15px;font-size:14px;font-weight:600}
  .svr-burger{display:flex;flex-direction:column;justify-content:center;gap:5px;width:44px;height:44px;padding:0 10px;background:none;border:1px solid var(--svr-line);border-radius:10px;cursor:pointer}
  .svr-burger span{display:block;height:2px;background:var(--svr-navy);border-radius:2px;transition:transform .2s ease,opacity .2s ease}
  .svr-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .svr-burger[aria-expanded="true"] span:nth-child(2){opacity:0}
  .svr-burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

  .svr-nav{position:absolute;left:0;right:0;top:100%;background:#fff;border-top:1px solid var(--svr-line);box-shadow:0 20px 30px rgba(4,9,42,.12);max-height:calc(100vh - 64px);overflow-y:auto;display:none;justify-content:flex-start}
  .svr-nav.is-open{display:block}
  .svr-nav__list{flex-direction:column;align-items:stretch;gap:0;padding:8px 16px 20px}
  .svr-nav__item{flex-wrap:wrap;border-bottom:1px solid var(--svr-line)}
  .svr-header .svr-nav__link{flex:1 1 0;padding:16px 4px;font-size:16px}
  .svr-header .svr-nav__link::after{display:none}
  .svr-nav__caret{padding:14px 12px;margin:0}
  .svr-nav__item.has-menu::before{display:none}
  .svr-mega{position:static;transform:none;width:100%;border:0;box-shadow:none;padding:0 0 10px;opacity:1;visibility:visible;display:none;flex:0 0 100%}
  .svr-nav__item.has-menu:hover .svr-mega,.svr-nav__item.has-menu:focus-within .svr-mega{display:none;transform:none}
  .svr-nav__item.has-menu.is-open .svr-mega{display:block;transform:none}
  .svr-mega__title{display:none}
  .svr-header .svr-mega__all{padding-left:10px}
  .svr-mega__grid{grid-template-columns:1fr 1fr;gap:0 10px}
  .svr-nav__item--cta-mobile{display:block;border-bottom:0;padding-top:18px}
  .svr-nav__item--cta-mobile .svr-cta{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:13px 20px;width:100%}
  .svr-nav__item--cta-mobile .svr-cta__label{font-size:15px}
  .svr-nav__item--cta-mobile .svr-cta__num{font-size:13.5px}
}
@media (max-width:420px){
  .svr-mega__grid{grid-template-columns:1fr}
  .svr-logo img{height:54px;margin:-7px 0}
}
@media (prefers-reduced-motion:reduce){
  .svr-header *{transition:none!important}
}

/* ---------- shared footer quick-links list (replaces the Elementor nav widget in footers) ---------- */
.svr-footer-nav ul{list-style:none;margin:0;padding:0}
.svr-footer-nav li{margin:0 0 9px}
.svr-footer-nav a{color:inherit;text-decoration:none;font-size:15px;opacity:.9;transition:color .15s ease,opacity .15s ease}
.svr-footer-nav a:hover{color:#F17406;opacity:1}
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-svr-header]');
  if (header) {
    const burger = header.querySelector<HTMLButtonElement>('.svr-burger')!;
    const nav = header.querySelector<HTMLElement>('#svr-nav')!;
    const menuItem = header.querySelector<HTMLElement>('.svr-nav__item.has-menu');
    const caret = header.querySelector<HTMLButtonElement>('.svr-nav__caret');

    const setBurger = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav.classList.toggle('is-open', open);
    };
    const setMenu = (open: boolean) => {
      menuItem?.classList.toggle('is-open', open);
      caret?.setAttribute('aria-expanded', String(open));
    };

    burger.addEventListener('click', () => setBurger(burger.getAttribute('aria-expanded') !== 'true'));
    caret?.addEventListener('click', (e) => {
      e.preventDefault();
      setMenu(!menuItem!.classList.contains('is-open'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { setMenu(false); setBurger(false); }
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (menuItem && !menuItem.contains(t)) setMenu(false);
      if (!header.contains(t)) setBurger(false);
    });
    window.matchMedia('(min-width: 981px)').addEventListener('change', () => { setBurger(false); setMenu(false); });
  }
</script>
