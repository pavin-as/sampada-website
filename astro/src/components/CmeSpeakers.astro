---
/**
 * Speaker cards. Confirmed speakers show photo, name, role and talk; the rest show a "To be announced" placeholder.
 * Defaults to the current registration event (src/data/cme.ts); the activities archive passes its own frozen `speakers`.
 */
import { CME_SPEAKERS } from '../data/cme';
interface Speaker { confirmed?: boolean; session: number; name?: string; role?: string; org?: string; topic?: string; photo?: string }
interface Props { compact?: boolean; speakers?: Speaker[]; sessionLabel?: string; tbaLabel?: string; tbaNote?: string }
const { compact = false, speakers = CME_SPEAKERS.map((s) => ({ ...s })), sessionLabel = 'Session', tbaLabel = 'To be announced', tbaNote = 'Name will be shared soon' } = Astro.props;
---
<ul class:list={['cme-speakers', { 'cme-speakers--compact': compact }]}>
  {speakers.map((s) => {
    const ok = s.confirmed !== false;
    return (
      <li class:list={['cme-speaker', { 'is-tba': !ok }]}>
        <div class="cme-speaker__avatar">
          {ok && s.photo ? (
            <img src={s.photo} alt={s.name} width="120" height="120" loading="lazy" />
          ) : (
            <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.1 0-7.5 2.2-7.5 5v1.5h15V19c0-2.8-3.4-5-7.5-5Z"/></svg>
          )}
        </div>
        <div class="cme-speaker__body">
          <p class="cme-speaker__tag">{sessionLabel} {s.session}</p>
          <h3 class="cme-speaker__name">{ok ? s.name : tbaLabel}</h3>
          {ok && (
            <p class="cme-speaker__role">{s.role}{s.org ? <><br />{s.org}</> : null}</p>
          )}
          {ok && s.topic && <p class="cme-speaker__topic">{s.topic}</p>}
          {!ok && <p class="cme-speaker__role">{tbaNote}</p>}
        </div>
      </li>
    );
  })}
</ul>
