---
/**
 * Evening schedule, with times and (for scientific sessions) the speaker and topic.
 * On /cme/ it defaults to the current registration event in src/data/cme.ts. The activities archive passes its own
 * frozen, already-translated `rows`, so old editions keep their programme after cme.ts moves on to the next year.
 */
import { CME_SCHEDULE, CME_SPEAKERS } from '../data/cme';
interface Row { time: string; title: string; note?: string; session?: number }
interface Talk { session: number; name?: string; topic?: string }
interface Props { rows?: Row[]; talks?: Talk[] }
const { rows = CME_SCHEDULE.map((s) => ({ ...s })), talks = CME_SPEAKERS.filter((x) => x.confirmed) } = Astro.props;
---
<ol class="cme-sched">
  {rows.map((s) => {
    const sp = s.session ? talks.find((x) => x.session === s.session) : undefined;
    return (
      <li class:list={['cme-sched__row', { 'is-talk': Boolean(s.session) }]}>
        <span class="cme-sched__time">{s.time}</span>
        <div class="cme-sched__body">
          <h3 class="cme-sched__t">{s.title}{sp?.name ? <span class="cme-sched__by"> &middot; {sp.name}</span> : null}</h3>
          {s.note && <p class="cme-sched__d">{s.note}</p>}
          {sp?.topic && <p class="cme-sched__d">{sp.topic}</p>}
        </div>
      </li>
    );
  })}
</ol>
